{
    // 编辑器格式
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.formatOnSave": true,
    "files.encoding": "utf8",

    // 文件排除，资源管理器隐藏，不会删除磁盘文件
    "files.exclude": {
        "**/build/**": true,
        "**/*.o": true,
        "**/*.elf": true
    },

    // 搜索时忽略目录
    "search.exclude": {
        "build/": true
    },

    // C_Cpp 扩展全局设置
    "C_Cpp.errorSquiggles": "enabled"
}
